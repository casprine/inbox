# Copy to deploy/.env (git-ignored; chmod 600) and fill in. docker compose reads it for docker-compose.prod.yml.
# Every secret is left empty on purpose. The server (INBOX_ENV=production) refuses to start, and logs every
# missing or weak setting by name, if something required is empty or still a placeholder.
# Order of work and where each value comes from: docs/DEPLOY.md.

# ---- Image (GitHub Container Registry) -------------------------------------------------------------------
# An explicit version tag (never :latest) or, best, a digest: ghcr.io/<owner>/<repo>/inbox-server@sha256:...
# image.yml prints both on each run's summary. Upgrade/rollback = change this line (docs/RUNBOOK.md).
INBOX_IMAGE=ghcr.io/OWNER/REPO/inbox-server:0.1.0

# ---- Postgres container ----------------------------------------------------------------------------------
# Any long random string, at least 16 characters; used only on the compose network. Generate: openssl rand -hex 24
# Do not change it after the first start (the volume keeps the old one); see RUNBOOK "Change the Postgres password".
POSTGRES_PASSWORD=

# ---- Sign-in ---------------------------------------------------------------------------------------------
# The one password the app asks for (at least 12 characters, not a placeholder). Kept only in this file: the
# server hashes it in memory at startup and stores nothing about it. Change it by editing here and restarting.
OWNER_PASSWORD=

# ---- Addresses -------------------------------------------------------------------------------------------
# The API address on the tailnet (Tailscale Serve), https, no trailing slash. Google's OAuth redirect is
# <PUBLIC_BASE_URL>/oauth/google/callback. Example: https://mac-mini.your-tailnet.ts.net
PUBLIC_BASE_URL=

# Host side of the two published ports (container ports stay 8080/8081). Loopback only; tailscaled is the way in.
# Change the ports only if something else on the Mac mini uses them, and then change the `tailscale serve/funnel`
# commands in docs/DEPLOY.md to match. Do not set the BIND values to 0.0.0.0 (it would publish them on your LAN).
API_BIND=127.0.0.1
API_PORT=8080
INGEST_BIND=127.0.0.1
INGEST_PORT=8081

# ---- Ingest (Cloudflare Worker -> server) ----------------------------------------------------------------
# HMAC secret shared with the Email Worker (`wrangler secret put INGEST_SECRET`), at least 32 characters.
# Generate: openssl rand -hex 32
INGEST_SECRET=

# ---- Gmail token encryption ------------------------------------------------------------------------------
# Keyring that seals the stored Gmail refresh token: id:base64,id:base64 (the first seals, all open).
# Generate one key:  echo "k1:$(openssl rand -base64 32)"   Back this up with the database: without it the
# Gmail connection cannot be read and Gmail must be reconnected. Rotation: docs/RUNBOOK.md.
TOKEN_ENC_KEYS=

# ---- Cloudflare R2 (S3 API) ------------------------------------------------------------------------------
# https://<account id>.r2.cloudflarestorage.com ; a bucket-scoped token with object read/write/delete.
S3_ENDPOINT=
S3_BUCKET=inbox-mail
S3_ACCESS_KEY=
S3_SECRET_KEY=
# R2 uses the region "auto".
S3_REGION=auto

# ---- Gmail (Google OAuth client) -------------------------------------------------------------------------
# Leave both empty until you connect Gmail (the app then shows Gmail as not configured); set both together.
# The server asks for gmail.modify and gmail.settings.basic in one consent.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Cloudflare API (optional: domain list and routing checks) -------------------------------------------
# A token with Zone:Read, Email Routing Rules:Read and Workers Scripts:Read. The server never edits routing.
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_WORKER_NAME=inbox-worker

# ---- Operations (all optional) ---------------------------------------------------------------------------
# A dead-man's-switch URL (for example healthchecks.io) pinged after every health snapshot, so you hear when the
# Mac mini is off, asleep or offline.
DEADMAN_URL=

# How often the server lists R2 for mail whose ping was lost (Go duration, at least 10s).
RECONCILE_INTERVAL=5m
# Objects younger than this are left for their own ping first (default 1m when empty).
RECONCILE_MIN_AGE=

# Header carrying the caller's address from the proxy, for per-client login lockout (UNVERIFIED for Tailscale
# Serve; see docs/DEPLOY.md). Leave empty unless you have confirmed the header is set by Serve.
LOGIN_IP_HEADER=

# ---- Logs to OpenTelemetry (optional; leave the endpoint empty to keep logs on stdout only) ---------------
# Base URL of your OTLP/HTTP backend (the server adds /v1/logs), your ingest key, and the lowest level to send:
# error, warn, info or debug. The key is sent as "Authorization: Bearer <key>". Extra headers, if your vendor
# needs a different scheme: OTEL_EXPORTER_OTLP_HEADERS=name=value,name2=value2 (this replaces nothing above).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_INGEST_KEY=
OTEL_LOG_LEVEL=info
OTEL_EXPORTER_OTLP_HEADERS=

# ---- Backups (read by scripts/backup.sh, not by the containers) ------------------------------------------
# Host directory the dumps are written to, and how many to keep.
BACKUP_DIR=~/inbox-backups
BACKUP_KEEP=14
# Optional off-site copy: set ALL FOUR to also upload each dump to an S3-compatible bucket (a second R2 bucket,
# not the mail bucket). Needs the `aws` CLI on the Mac mini. Empty = local copies only.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
