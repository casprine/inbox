# Copy to deploy/.env (git-ignored) and fill in. docker compose reads it for docker-compose.prod.yml.
# Everything here is a secret except the image name and the addresses.

# The server image on GitHub Container Registry (docs/DEPLOY.md, "Container image on GitHub").
INBOX_IMAGE=ghcr.io/OWNER/REPO/inbox-server:latest

# Postgres container password (any long random string; used only on the compose network).
POSTGRES_PASSWORD=

# The one sign-in password for the app (at least 12 characters; the server refuses to start otherwise).
# Kept only in this file. The server hashes it in memory at startup and stores nothing about it.
OWNER_PASSWORD=

# The API address on the tailnet (Tailscale Serve), no trailing slash. Google's OAuth redirect is
# <PUBLIC_BASE_URL>/oauth/google/callback.
PUBLIC_BASE_URL=https://your-mac-mini.your-tailnet.ts.net

# Shared with the Email Worker (wrangler secret put INGEST_SECRET). Generate: openssl rand -hex 32
INGEST_SECRET=

# Keyring for the stored Gmail token: id:base64,id:base64 (first seals, all open). Generate one key:
#   echo "k1:$(openssl rand -base64 32)"
TOKEN_ENC_KEYS=

# Cloudflare R2 (S3 API): https://<account id>.r2.cloudflarestorage.com, a bucket-scoped token's keys.
S3_ENDPOINT=
S3_BUCKET=inbox-mail
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Gmail (Google OAuth client; optional until you connect Gmail).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare API (optional: domain list and routing checks).
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_WORKER_NAME=inbox-worker

# Optional: a dead-man's-switch URL pinged after every health snapshot.
DEADMAN_URL=

# How often the server lists R2 for mail whose ping was lost (Go duration, at least 10s). Default 5m.
RECONCILE_INTERVAL=5m

# Optional: header carrying the caller's address from the proxy, for per-client login lockout.
LOGIN_IP_HEADER=
